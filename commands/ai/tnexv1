/**
 * .tnexv1 — T-Nex v1 AI (Thenux / TOBI)
 * Only works with: .tnexv1 <prompt>
 * API: https://tobi-apisiii-production.up.railway.app/api/thenux/t-nex-v1
 */
const axios = require('axios');

const API = 'https://tobi-apisiii-production.up.railway.app/api/thenux/t-nex-v1';
const API_KEY = 'tobi_live_4a3b3434c3161294b477ff28';
const THUMB = 'https://files.catbox.moe/ti2zgx.webp';
const FOOTER = 'DARK QUEEN OFC · T-Nex v1';

async function replyWithImage(sock, from, msg, text) {
  const caption = String(text) + '\n\n> ✦ ' + FOOTER + ' ✦';
  try {
    await sock.sendMessage(
      from,
      { image: { url: THUMB }, caption },
      msg ? { quoted: msg } : undefined
    );
  } catch (_) {
    await sock.sendMessage(
      from,
      { text: caption },
      msg ? { quoted: msg } : undefined
    );
  }
}

async function askTnex(prompt) {
  const res = await axios.get(API, {
    params: {
      prompt: prompt,
      apikey: API_KEY,
    },
    timeout: 90000,
    headers: {
      'User-Agent': 'Mozilla/5.0 DarkQueenBot',
      Accept: 'application/json',
    },
    validateStatus: () => true,
  });

  if (res.status !== 200) {
    throw new Error('HTTP ' + res.status);
  }

  const data = res.data;
  if (!data || data.success === false) {
    throw new Error((data && (data.message || data.error)) || 'API error');
  }

  const answer =
    data.reply ||
    data.result ||
    data.response ||
    data.message ||
    data.answer ||
    null;

  if (!answer || !String(answer).trim()) {
    throw new Error('Empty reply from T-Nex v1');
  }

  return {
    text: String(answer).trim(),
    ms: data.durationMs || null,
    model: data.model || 'T-Nex v1',
    quota: data._quota || null,
  };
}

module.exports = {
  name: 'tnexv1',
  aliases: [],
  description: 'T-Nex v1 AI chat',
  category: 'ai',

  async execute({ sock, msg, from, args }) {
    const prompt = (args || []).join(' ').trim();

    if (!prompt) {
      return replyWithImage(
        sock,
        from,
        msg,
        '╭───「 ⚡ *T-NEX V1* 」───╮\n\n' +
          'Usage:\n' +
          '• `.tnexv1 your question`\n\n' +
          'Model: *T-Nex v1*\n' +
          'Provider: *T-NEX Core*\n' +
          '╰──────────────────────╯'
      );
    }

    try {
      await sock.sendMessage(from, { react: { text: '⚡', key: msg.key } }).catch(() => {});
    } catch (_) {}

    let loading;
    try {
      loading = await sock.sendMessage(
        from,
        { text: '⏳ *T-Nex v1 thinking…*' },
        { quoted: msg }
      );
    } catch (_) {}

    try {
      const result = await askTnex(prompt);
      let meta = 'Model: *' + result.model + '*';
      if (result.ms) meta += ' · ' + result.ms + 'ms';
      if (result.quota && result.quota.requestsRemaining != null) {
        meta += '\nQuota left: *' + result.quota.requestsRemaining + '*';
      }

      const text =
        '╭───「 ⚡ *T-NEX V1* 」───╮\n\n' +
        result.text +
        '\n\n' +
        '╰─ ' +
        meta +
        '\n';

      if (loading) {
        try {
          await sock.sendMessage(from, { delete: loading.key }).catch(() => {});
        } catch (_) {}
      }

      await replyWithImage(sock, from, msg, text);
      await sock.sendMessage(from, { react: { text: '✅', key: msg.key } }).catch(() => {});
    } catch (err) {
      console.error('T-Nex v1 Error:', err.message);
      const errText = '❌ *T-Nex v1 fail*\n\n`' + (err.message || 'Unknown') + '`';
      if (loading) {
        try {
          await sock.sendMessage(from, { text: errText, edit: loading.key });
        } catch (_) {
          await sock.sendMessage(from, { text: errText }, { quoted: msg }).catch(() => {});
        }
      } else {
        await sock.sendMessage(from, { text: errText }, { quoted: msg }).catch(() => {});
      }
      await sock.sendMessage(from, { react: { text: '❌', key: msg.key } }).catch(() => {});
    }
  },
};

# ================================
# DCL MINI - Environment Variables
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# MongoDB Connection String (required)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# Bot Configuration
BOT_NAME=DCL MINI
PREFIX=.
OWNER_NUMBER=94769904294  # Your number without + (country code + number)

# Server
PORT=3000
HOST=0.0.0.0

# Session ID (unique name for this bot instance)
SESSION_ID=dcl-mini-main

# Optional: OpenAI / AI keys (for .ai .gpt commands)
# OPENAI_API_KEY=sk-...

# Optional: Other API keys
# WEATHER_API_KEY=
# NEWS_API_KEY=

# Timezone
TZ=Asia/Colombo
